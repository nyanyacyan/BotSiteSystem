{
  "name": "Order Notification Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "order-notification",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "channel": "#orders",
        "text": "=新しい注文が入りました！\n注文ID: {{$json[\"order_id\"]}}\n顧客: {{$json[\"customer_name\"]}}\n金額: ¥{{$json[\"total_amount\"]}}"
      },
      "name": "Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "fromEmail": "noreply@botsitesystem.com",
        "toEmail": "={{$json[\"customer_email\"]}}",
        "subject": "ご注文ありがとうございます",
        "text": "=ご注文を承りました。\n\n注文ID: {{$json[\"order_id\"]}}\n合計金額: ¥{{$json[\"total_amount\"]}}\n\nありがとうございました。"
      },
      "name": "Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [450, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Slack",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "id": "1"
}
