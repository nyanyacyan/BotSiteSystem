# ========================================
# BotSiteSystem 環境変数設定
# ========================================
# ⚠️ 重要: このファイルをコピーして .env を作成してください
# ⚠️ .env ファイルは絶対にバージョン管理にコミットしないでください
# ⚠️ 本番環境では必ずすべてのパスワードとシークレットキーを変更してください
# ========================================

# Django Configuration
# ⚠️ 本番環境では必ず変更してください！
# 生成方法: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# ⚠️ 本番環境では強力なパスワードを使用してください
DB_NAME=botsite_db
DB_USER=botsite_user
DB_PASSWORD=botsite_password
DB_HOST=db
DB_PORT=5432

# Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# n8n Configuration
# ⚠️ 本番環境では強力なパスワードを使用してください
N8N_USER=admin
N8N_PASSWORD=admin
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://n8n:5678/webhook
N8N_API_KEY=

# AWS Configuration (for production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-1

# Email Configuration (for production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
